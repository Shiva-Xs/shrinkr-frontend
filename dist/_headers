/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.shrinkr.in; frame-ancestors 'none';

/favicon.svg
  Cache-Control: public, max-age=86400, immutable

/og-image.png
  Cache-Control: public, max-age=86400, immutable

/favicon-32.png
  Cache-Control: public, max-age=86400, immutable

/favicon-48.png
  Cache-Control: public, max-age=86400, immutable

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
